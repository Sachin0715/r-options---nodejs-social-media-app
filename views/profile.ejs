
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">

        <!-- Logout Button -->
        <div class="w-full flex justify-end">
            <a
                class="bg-red-500 rounded-md px-3 py-2 text-sm inline-block"
                href="/logout"
            >
                Logout
            </a>
        </div>

        <!-- Profile Section -->
        <div class="flex items-start gap-3 mt-5">
            <div class="w-10 h-10 bg-red-500 rounded-md overflow-hidden">
  <img
    class="w-10 h-10 object-cover rounded-full"
    src="/images/Uploads/<%= user.profilepic %>"
    alt="Profile"
/>
            </div>

            <div class="flex-1">
                <h3 class="text-3xl">
                    <span class="font-light">Hello</span>,
                    <%= user.name %> 
                </h3>
<h5 class="mb-4 mt-2">You can create a new post</h5>

<form method="post" action="/post">
    <textarea
        placeholder="What's on your mind?"
        class="p-3 outline-none w-full max-w-lg resize-none bg-transparent border-2 border-zinc-800 rounded-md"
        name="content"
        required
    ></textarea>

    <input
        class="px-3 w-40 py-2 text-sm bg-blue-500 rounded-md mt-2 cursor-pointer"
        type="submit"
        value="Create your post"
    >
</form>
               
            </div>
        </div>

        <!-- Posts Section -->
        <div class="post mt-12">
            <h3 class="text-zinc-400 text-xl">Your Posts</h3>

            <div class="postcontainer mt-5">

                <% user.posts.slice().reverse().forEach(function(post) { %>

                    <div class="post w-full max-w-lg p-4 mb-4 rounded-md bg-zinc-800 border border-zinc-700">

                        <h4 class="text-blue-400 mb-2">
                            @<%= user.username %>
                        </h4>

                        <p class="text-sm tracking-tight whitespace-pre-wrap break-words">
                            <%= post.content %>
                        </p>

                        <small class="mt-2 inline-block text-zinc-400">
                            <%= post.likes.length %> Likes
                        </small>

                        <div class="btns flex mt-3 gap-4">

                            <a
                                class="text-blue-400 hover:text-blue-300"
                                href="/like/<%= post._id %>"
                            >
                                <%= post.likes.some(function(id) {
                                    return id.toString() === user._id.toString();
                                }) ? "Unlike" : "Like" %>
                            </a>

                            <a
                                class="text-zinc-400 hover:text-white"
                                href="/edit/<%= post._id %>"
                            >
                                Edit
                            </a>

                        </div>
                    </div>

                <% }) %>

            </div>
        </div>

    </div>
</body>
</html>
